> /
> 
. if "$cd"=="" {
.         di as error "Global cd is not set. Define global cd before running we
> ights_synth.do."
.         exit 198
. }

. 
. capture mkdir "$cd/output"

. capture mkdir "$cd/output/weights_synth"

. 
. capture confirm file "$cd/temp/matches_synth_vweights.dta"

. if _rc {
.         di as error "Missing temp/matches_synth_vweights.dta. Run code/matche
> s_synth.do first."
.         exit 601
. }

. 
. use "$cd/temp/matches_synth_vweights.dta", clear

. drop if missing(covariate) | missing(v_weight)
(6,630 observations deleted)

. 
. collapse (count) n=v_weight (mean) mean_v=v_weight (p50) med_v=v_weight (p25)
>  p25_v=v_weight (p75) p75_v=v_weight, by(covariate)

. gsort -mean_v covariate

. 
. gen covariate_label = covariate

. replace covariate_label = "Gender" if covariate=="gender"
(1 real change made)

. replace covariate_label = "Score" if covariate=="scoreN"
(1 real change made)

. replace covariate_label = "Migrant" if covariate=="migrant"
(1 real change made)

. replace covariate_label = "Bullying" if covariate=="bullying_union"
(1 real change made)

. replace covariate_label = "Mood" if covariate=="moodgeneral"
(1 real change made)

. replace covariate_label = "Patience" if covariate=="patienceN"
(1 real change made)

. replace covariate_label = "CRT" if covariate=="crtN"
(1 real change made)

. replace covariate_label = "Financial literacy" if covariate=="finN"
variable covariate_label was str14 now str18
(1 real change made)

. replace covariate_label = "Risk tolerance" if covariate=="riskyN"
(1 real change made)

. replace covariate_label = "Inequality attitudes" if covariate=="inequalityN"
variable covariate_label was str18 now str20
(1 real change made)

. replace covariate_label = "Honesty" if covariate=="honest"
(0 real changes made)

. 
. order covariate covariate_label n mean_v med_v p25_v p75_v

. export delimited using "$cd/output/weights_synth/synth_covariate_vweights_sum
> mary.csv", replace
file /Users/diegogonzalezgonzalez/Desktop/LOYOLA/PhD/2nd chapter/output/weights
> _synth/synth_covariate_vweights_summary.csv saved

. 
. tempfile wsum

. save `wsum', replace
(file /var/folders/qh/5fzr2y912sx0qqljkw0hx5rr0000gn/T//St15235.000001 not
    found)
file /var/folders/qh/5fzr2y912sx0qqljkw0hx5rr0000gn/T//St15235.000001 saved
    as .dta format

. 
. file open tex using "$cd/output/weights_synth/synth_covariate_vweights_table.
> tex", write replace

. file write tex "\begin{table}[!htbp]" _n

. file write tex "\centering" _n

. file write tex "\caption{Synthetic-control covariate weights (V-matrix diagon
> al)}" _n

. file write tex "\begin{tabular}{lccccc}" _n

. file write tex "\hline" _n

. file write tex "Covariate & Mean & Median & P25 & P75 & N \\\\" _n

. file write tex "\hline" _n

. 
. use `wsum', clear

. quietly count

. forvalues i=1/`=r(N)' {
  2.         local cov = covariate_label[`i']
  3.         local mean : display %9.4f mean_v[`i']
  4.         local med  : display %9.4f med_v[`i']
  5.         local p25  : display %9.4f p25_v[`i']
  6.         local p75  : display %9.4f p75_v[`i']
  7.         local nn   : display %9.0f n[`i']
  8.         file write tex "`cov' & `mean' & `med' & `p25' & `p75' & `nn' \\\\
> " _n
  9. }

. 
. file write tex "\hline" _n

. file write tex "\end{tabular}" _n

. file write tex "\end{table}" _n

. file close tex

. 
. graph hbar mean_v, over(covariate_label, sort(mean_v) descending label(labsiz
> e(small))) ///
>         ytitle("Average V weight") title("Synthetic-control covariate importa
> nce")

