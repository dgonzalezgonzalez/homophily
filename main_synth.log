 17.         duplicates drop
 18.         merge m:1 usuario_id match_id using `dir1', keep(master match) nog
> en
 19.         replace assort_`nwk'_dir1 = 0 if missing(assort_`nwk'_dir1)
 20.         merge m:1 usuario_id match_id using `dir2', keep(master match) nog
> en
 21.         replace assort_`nwk'_dir2 = 0 if missing(assort_`nwk'_dir2)
 22. 
.         gen assort_`nwk'_union = (assort_`nwk'_dir1 == 1 | assort_`nwk'_dir2 
> == 1)
 23.         gen assort_`nwk'_inter = (assort_`nwk'_dir1 == 1 & assort_`nwk'_di
> r2 == 1)
 24. 
.         foreach var in assort_`nwk'_dir1 assort_`nwk'_dir2 assort_`nwk'_union
>  assort_`nwk'_inter {
 25.                 replace `var'=. if match_id==.
 26.                 gen w`var'=`var'*synth_weight
 27.         }
 28.         save "$cd/temp/assort_synth_`nwk'.dta", replace
 29. }

