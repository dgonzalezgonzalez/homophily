. foreach c in `class_list' {
  2.         use `base', clear
  3.         keep if class_id=="`c'"
  4.         quietly count
  5.         if r(N)<2 continue
  6. 
.         levelsof usuario_id, local(treated_ids)
  7. 
.         foreach tu of local treated_ids {
  8.                 use `base', clear
  9.                 keep if class_id=="`c'"
 10.                 expand 2
 11.                 bys usuario_id: gen te = _n
 12.                 xtset usuario_id te
 13. 
.                 capture erase `keep_w'
 14.                 capture quietly synth scoreN gender migrant bullying_union
>  moodgeneral patienceN crtN finN riskyN inequalityN honest, ///
>                         trunit(`tu') trperiod(2) keep(`keep_w') replace maxit
> er(200)
 15.                 if _rc!=0 continue
 16. 
.                 * Store donor weights for treated unit.
.                 use `keep_w', clear
 17.                 keep _Co_Number _W_Weight
 18.                 rename _Co_Number match_id
 19.                 rename _W_Weight count_match
 20.                 drop if missing(count_match)
 21.                 quietly count
 22.                 if r(N)>0 {
 23.                         forvalues i = 1/`=_N' {
 24.                                 post `donorh' (`tu') (match_id[`i']) (coun
> t_match[`i'])
 25.                         }
 26.                 }
 27. 
.                 * Store covariate weights (diagonal of V matrix).
.                 matrix V = e(V_matrix)
 28.                 local p = rowsof(V)
 29.                 local j = 0
 30.                 foreach vname of global xlist {
 31.                         local ++j
 32.                         if `j'>`p' continue, break
 33.                         scalar wj = V[`j',`j']
 34.                         post `vh' (`tu') ("`vname'") (wj)
 35.                 }
 36.         }
 37. }
